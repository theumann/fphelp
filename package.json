{
  "name": "fphelp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:screens": "playwright test -c playwright.screenshots.config.ts",
    "build:logo": "node --import tsx scripts/build-logo-assets.mts",
    "e2e:db": "node --env-file=.env.e2e --import tsx scripts/e2e-db.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:bootstrap": "node --import tsx scripts/bootstrap-owner.mts",
    "db:clear-digest": "node --env-file-if-exists=.env --import tsx scripts/clear-test-digest.mts",
    "job:capture": "node --import tsx scripts/capture-history.mts",
    "fpl:snapshot": "node --import tsx scripts/fpl-snapshot.mts",
    "fpl:record": "node --import tsx scripts/record-fixtures.mts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@sentry/nextjs": "^10.71.0",
    "@sentry/node": "^10.71.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "tsx": "^4.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
