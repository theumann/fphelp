# Copy to `.env.e2e`. Used only by the Playwright suite.
#
# A SEPARATE database from fphelp_dev: the suite truncates every table between tests,
# and `e2e/support/db.ts` refuses to run against anything not named fphelp_e2e.
#
# Create and migrate it with:
#   npm run e2e:db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fphelp_e2e

# Any value. Sessions are inserted directly, so this only has to exist.
AUTH_SECRET=e2e-secret-not-used-anywhere-real

# Deliberately no AUTH_RESEND_KEY and no AUTH_EMAIL_FROM. Nothing in the suite should be
# able to send mail, and a digest send without a from-address is meant to fail.
