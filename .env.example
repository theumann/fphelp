# Copy to `.env` and fill in your local Postgres password.
#
# Local development database.
#
# Production is a separate Railway Postgres on the private network, migrated by the
# preDeployCommand in railway.json — it is deliberately NOT reachable from here.
#
# Create the local database once:
#   psql -U postgres -c "CREATE DATABASE fphelp_dev;"
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/fphelp_dev

# Which FPL league the capture cron and the scripts work on. Optional — defaults to
# the reference league (9999999). This is the number from the league URL, NOT the invite
# code: `1xrliv` is a join code and cannot be converted to a league ID.
#
# The web app does NOT read this. Pages take the league from the URL
# (/l/<fplLeagueId>/send) and resolve it against leagues the signed-in owner belongs to,
# so one deployment serves many. Making the cron do the same is MULTI-LEAGUE.md phase B.
# FPL_LEAGUE_ID=9999999
