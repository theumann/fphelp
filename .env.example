# Copy to `.env` and fill in your local Postgres password.
#
# Local development database.
#
# Production is a separate Railway Postgres on the private network, migrated by the
# preDeployCommand in railway.json — it is deliberately NOT reachable from here.
#
# Create the local database once:
#   psql -U postgres -c "CREATE DATABASE fphelp_dev;"
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/fphelp_dev

# Default league for the operational SCRIPTS only — add-owner, clear-test-digest,
# fpl-snapshot, record-fixtures — when none is named on the command line. The number
# from the league URL, NOT the invite code: `1xrliv` is a join code and cannot be
# converted to a league ID.
#
# Nothing in a running deployment reads this any more. Pages take the league from the URL
# (/l/<fplLeagueId>/send) and the capture cron iterates the leagues table, so setting or
# changing it cannot affect the served app — only what a script does when you don't tell it.
# FPL_LEAGUE_ID=9999999

# --- Auth host resolution -------------------------------------------------
#
# AUTH_TRUST_HOST lets Auth.js build callback and magic-link URLs from the request's
# Host header. AUTH_URL pins them to a fixed origin instead.
#
# These do NOT complement each other: AUTH_URL WINS. Setting it means trust-host is
# ignored, and every emailed link points at that origin no matter which address you
# actually browsed to - including the callbackUrl baked into the link, so editing the
# host by hand does not help either. The link sends you back to the pinned one.
#
# Locally, LEAVE AUTH_URL UNSET. Then a link works on localhost, on your LAN IP, and on
# whatever address you get on someone else's wifi, with no edit when the network moves.
# A pinned DHCP address is correct until the lease changes and then silently is not.
#
# In PRODUCTION it is set, deliberately, and should stay set: a public host that trusts
# arbitrary Host headers can be induced to mint sign-in links pointing at someone else's
# domain. On a LAN you are the only one sending that header; on the internet you are not.
AUTH_TRUST_HOST=true
# AUTH_URL=http://localhost:3000

# Shown on the sign-in page when an address is refused, as "Still stuck? Write to X."
# Optional: unset simply omits the sentence, which is the right default rather than
# promising a reply nobody is reading. Read per request, so it can be set in Railway
# without a rebuild. It is rendered to anyone who reaches that page, so pick an address
# you are happy to have scraped.
# SUPPORT_EMAIL=hello@fphelp.app
