# Copy to `.env` and fill in your local Postgres password.
#
# Local development database.
#
# Production is a separate Railway Postgres on the private network, migrated by the
# preDeployCommand in railway.json — it is deliberately NOT reachable from here.
#
# Create the local database once:
#   psql -U postgres -c "CREATE DATABASE fphelp_dev;"
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/fphelp_dev

# Default league for the operational SCRIPTS only — add-owner, clear-test-digest,
# fpl-snapshot, record-fixtures — when none is named on the command line. The number
# from the league URL, NOT the invite code: `1xrliv` is a join code and cannot be
# converted to a league ID.
#
# Nothing in a running deployment reads this any more. Pages take the league from the URL
# (/l/<fplLeagueId>/send) and the capture cron iterates the leagues table, so setting or
# changing it cannot affect the served app — only what a script does when you don't tell it.
# FPL_LEAGUE_ID=9999999
